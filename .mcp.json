{
  "mcpServers": {
    "home-main-k8s-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "kubernetes-mcp-server@latest"
      ],
      "env": {
        "KUBECONFIG": "/mnt/stanislawjakiel/projects/cfg/kubeconfig/home.yaml"
      }
    },
    "home-main-grafana-mcp-server": {
      "command": "/home/stanislaw/.local/bin/uvx",
      "args": [
        "mcp-grafana"
      ],
      "env": {
        "GRAFANA_URL": "https://grafana.int.l3a.dev",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      }
    },
    "gitlab-l3a": {
      "type": "http",
      "url": "https://gitlab.l3a.dev/api/v4/mcp"
    },
    "home-assistant": {
      "type": "http",
      "url": "https://hass.l3a.dev/api/mcp",
      "headers": {
        "Authorization": "Bearer ${HASS_TOKEN}"
      }
    }
  }
}
